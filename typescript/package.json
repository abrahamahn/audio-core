{
  "name": "@abrahamahn/audio-core",
  "version": "0.2.0",
  "description": "Framework-neutral semantic audio scheduling, lifecycle, policy, spatial, and asset primitives",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Abraham Joongwhan Ahn",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/audio-core.git",
    "directory": "typescript"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web-audio": {
      "source": "./src/web-audio.ts",
      "types": "./dist/web-audio.d.ts",
      "default": "./dist/web-audio.js"
    },
    "./web-audio-stream": {
      "source": "./src/web-audio-stream.ts",
      "types": "./dist/web-audio-stream.d.ts",
      "default": "./dist/web-audio-stream.js"
    },
    "./web-audio-effects": {
      "source": "./src/web-audio-effects.ts",
      "types": "./dist/web-audio-effects.d.ts",
      "default": "./dist/web-audio-effects.js"
    },
    "./rust-audio-worklet": {
      "source": "./src/rust-audio-worklet.ts",
      "types": "./dist/rust-audio-worklet.d.ts",
      "default": "./dist/rust-audio-worklet.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check:worklet": "node --check scripts/build-wasm.mjs && node --check worklet/rust-effects-processor.js && node --check dist/audio-worklet/rust-effects-processor.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "type-check": "pnpm typecheck",
    "lint": "eslint src tests tests-browser --max-warnings 0",
    "test": "vitest run",
    "pretest:browser": "pnpm build:wasm",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "prepack": "pnpm build && pnpm build:wasm && pnpm check:worklet && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.13"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.26.2"
}
